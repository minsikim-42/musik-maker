{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://minsikim-42.github.io/musik-maker/schema/song.schema.json",
  "title": "musik-maker song (AI-friendly JSON)",
  "description": "왼쪽 드로어 → '📋 JSON 내보내기/불러오기 (AI용)'에서 주고받는 곡 포맷. 격자 1칸 = 16분음표. 칸 수 = bars × beatUnit × barBeats. 자세한 규칙은 AGENTS.md 참고.",
  "type": "object",
  "required": ["tracks"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "description": "곡 이름" },
    "bpm": { "type": "number", "minimum": 40, "maximum": 220, "default": 120 },
    "bars": { "type": "integer", "minimum": 1, "description": "마디 수", "default": 2 },
    "beatUnit": { "type": "integer", "minimum": 1, "default": 4, "description": "한 박당 칸 수(기본 4=16분음표 격자)" },
    "barBeats": { "type": "integer", "minimum": 1, "default": 4, "description": "한 마디당 박 수" },
    "steps": {
      "type": "integer",
      "description": "정보용 힌트(= bars × beatUnit × barBeats). 불러오기는 이 값을 무시하고 다시 계산한다. t는 0 ~ steps-1."
    },
    "sounds": {
      "type": "array",
      "description": "곡 전용 커스텀 신스. 트랙에서 \"sound\":\"<이 소리의 name>\"으로 참조한다. 선택.",
      "items": { "$ref": "#/definitions/sound" }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/track" }
    }
  },
  "definitions": {
    "track": {
      "type": "object",
      "required": ["notes"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["melody", "drums"],
          "description": "드럼 트랙은 \"drums\". 생략하면 멜로디."
        },
        "instrument": {
          "type": "string",
          "enum": ["piano", "synth", "pluck", "bass", "guitar", "wind"],
          "description": "기본 내장 악기. 커스텀 소리를 쓰려면 대신 \"sound\"를 쓴다."
        },
        "sound": {
          "type": "string",
          "description": "최상위 sounds[] 안의 어떤 소리 name. 있으면 instrument보다 우선."
        },
        "volume": { "type": "number", "minimum": -30, "maximum": 6, "description": "트랙 볼륨(dB). 0=기본." },
        "muted": { "type": "boolean", "default": false },
        "reverb": { "type": "boolean", "default": false, "description": "트랙 잔향(리버브) 켜기." },
        "notes": {
          "type": "array",
          "items": { "$ref": "#/definitions/note" }
        }
      }
    },
    "note": {
      "type": "object",
      "required": ["n", "t"],
      "additionalProperties": false,
      "properties": {
        "n": {
          "type": "string",
          "description": "멜로디: 'C5','F#4' 같은 음이름(음역 C3~C6). 드럼: '킥','스네어','하이햇'(kick/snare/hihat/hh 별칭도 허용). 모르는 이름은 배치되지 않고 리포트에 집계된다."
        },
        "t": {
          "type": "integer",
          "minimum": 0,
          "description": "칸 번호(0부터). 0 ~ steps-1. 범위 밖은 무시되고 리포트에 집계된다."
        },
        "h": {
          "type": "boolean",
          "description": "true면 그 칸의 반박자(32분음표) 뒤에 찍힌다."
        }
      }
    },
    "sound": {
      "type": "object",
      "required": ["name"],
      "description": "빼기식 신스(MonoSynth) 파라미터. 지정 안 한 필드는 기본값이 채워진다. 공유 링크(코덱)에는 파형·ADSR·컷오프·볼륨만 담기고, 나머지 확장 필드는 세션·이 JSON에만 온전히 저장된다.",
      "properties": {
        "name": { "type": "string" },
        "wave": {
          "type": "string",
          "enum": ["sine", "triangle", "square", "sawtooth", "pulse"],
          "default": "sawtooth",
          "description": "기본 파형. 레트로/칩튠은 square 또는 pulse."
        },
        "pulseWidth": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.5,
          "default": 0.25,
          "description": "wave가 'pulse'일 때만 의미. 0.5=사각과 동일, 0.25/0.125=클래식 칩튠 듀티."
        },
        "attack": { "type": "number", "minimum": 0, "maximum": 2, "default": 0.01 },
        "decay": { "type": "number", "minimum": 0, "maximum": 2, "default": 0.2 },
        "sustain": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.4 },
        "release": { "type": "number", "minimum": 0, "maximum": 3, "default": 0.6 },
        "filterOn": { "type": "boolean", "default": true, "description": "false면 필터 없는 생 오실레이터(순수 파형, AI 아티팩트와 동일 구조). false일 땐 cutoff·resonance·filter* 값은 무시된다." },
        "cutoff": { "type": "number", "minimum": 200, "maximum": 8000, "default": 2000, "description": "로우패스 컷오프(Hz). 낮추면 먹먹, 높이면 선명. filterOn=false면 무시." },
        "resonance": { "type": "number", "minimum": 0.5, "maximum": 12, "default": 1 },
        "filterType": { "type": "string", "enum": ["lowpass", "highpass", "bandpass"], "default": "lowpass" },
        "filterEnvAmount": { "type": "number", "minimum": 0, "maximum": 6, "default": 0, "description": "소리 나는 동안 밝기가 열리는 양(oct). 0=고정." },
        "filterDecay": { "type": "number", "minimum": 0.02, "maximum": 1.5, "default": 0.3 },
        "detune": { "type": "number", "minimum": 0, "maximum": 60, "default": 0, "description": "유니즌 두께(슈퍼소우). pulse에는 적용 안 됨." },
        "distortion": { "type": "number", "minimum": 0, "maximum": 1, "default": 0 },
        "bitcrush": { "type": "number", "minimum": 0, "maximum": 1, "default": 0, "description": "해상도를 낮춰 8비트 레트로 질감. 칩튠에 유용." },
        "chorus": { "type": "number", "minimum": 0, "maximum": 1, "default": 0 },
        "delay": { "type": "number", "minimum": 0, "maximum": 1, "default": 0, "description": "메아리(피드백 딜레이). 던전·우주 공간감. 0=끔." },
        "vibrato": { "type": "number", "minimum": 0, "maximum": 1, "default": 0 },
        "tremolo": { "type": "number", "minimum": 0, "maximum": 1, "default": 0 },
        "volume": { "type": "number", "minimum": -30, "maximum": 0, "default": -8 }
      }
    }
  }
}
